# ==============================================================================
# NOTRPC REALTIME CARD GAME - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Port (Default: 8000)
PORT=8000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=element_clash
DB_USER=postgres
DB_PASSWORD=postgres

# Authentication Secret
JWT_SECRET=element_clash_super_secret_jwt_key_2026

# Discord Developer Portal Application Configuration
# Get these credentials from: https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Public Domain / Proxy URL (Cloudflare Tunnel, Ngrok, Railway, Render, etc.)
# Used for Discord Activity URL Mapping proxy reference
PUBLIC_SERVER_URL=https://your-domain.trycloudflare.com

